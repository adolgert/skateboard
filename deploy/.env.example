# Copy to .env and set your own token. .env is ignored by git.
#
# One token: the agent and the ledger command line present it to the gateway,
# and the gateway presents it to the builder and the oracle.
EQUIVALENT_TOKEN=change-me-local-dev-token

# Which region the agent's session works on.
EQUIVALENT_REGION=ch04:step

# How the session reaches a model. Either set these in the terminal you start
# pi.sh from, and nothing is written to disk, or set them here, and they are
# written to a file git ignores. A value in the terminal wins over one here.
# Only the agent container receives them.
#
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#
# The names are pi's own; `pi --help` lists them all, and
# docker-compose.yml lists the ones it forwards. Add a line there for a
# provider it does not name yet.
