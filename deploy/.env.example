# Copy to .env and set your own token. API keys are NOT set here --
# ANTHROPIC_API_KEY is forwarded from your shell environment by docker compose,
# so it never lands on disk.
#
# One token: the agent and the ledger command line present it to the gateway,
# and the gateway presents it to the builder and the oracle.
EQUIVALENT_TOKEN=change-me-local-dev-token

# Which region the agent's session works on.
EQUIVALENT_REGION=ch04:step
