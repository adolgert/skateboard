# Python
**/__pycache__/
*.pyc

# Packaging artifacts from `pip install -e .` and wheel builds
*.egg-info/
build/
dist/

# Fortran build artifacts. A code's baseline tree is also where the Fortran
# gets compiled by hand, so its executables land beside the source.
*.mod
*.o
programs/*/baseline/tsunami
programs/*/harness/.build/

# A local token left over from the demonstration harness's own .env
demo/.env

# Deployment state: the gateway's repository, the ledger, the working copy,
# the sessions, and the local token. Use deploy/.env.example.
deploy/.env
deploy/state/

# LaTeX build artifacts
docs/*.aux
docs/*.log
docs/*.fdb_latexmk
docs/*.fls
docs/*.out
docs/*.synctex.gz

# Third-party tsunami clone (its own git history) and the external TRACTOR report
codes/
docs/First_TRACTOR_Evaluation_Report/
docs/First_TRACTOR_Evaluation_Report.pdf
docs/marker_output/

# Session build logs
.nvhpc_pull.log
.nvhpc_pull.sh
.compose_build.log

notes/

# Region-harness artifacts
ftgdata/
.venv/
tools/regionharness/cases/*/fcg/asm/
tools/regionharness/cases/*/fcg/pre/
tools/regionharness/cases/*/fcg/cache/
tools/regionharness/cases/*/fcg/modtmp/
tools/regionharness/cases/*/replay/build/
