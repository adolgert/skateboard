# Local dev config. ANTHROPIC_API_KEY is intentionally NOT stored here — it is
# forwarded from the shell environment by docker compose. Do not commit secrets.
SKATEBOARD_TOKEN=sk8-local-dev-7f3a9c2e
AGENT_BACKEND=anthropic
AGENT_MODEL=claude-opus-4-8

# Campaign: codestral:22b-v0.1-q4_0, 100 attempts on the OpenMP target rung,
# now with mem:managed. Sampling study: STOP_ON_ACCEPT=0 runs the full budget
# and collects every acceptance and its speedup instead of stopping at the first.
RUN_STAMP=codestral100t4
MAX_ATTEMPTS=100
MODEL_KEYS=codestral
RUNGS=omp_target
AGENT_TEMPERATURE=0.4
STOP_ON_ACCEPT=0
