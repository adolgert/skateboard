# Copy to .env and adjust. API keys are NOT set here — ANTHROPIC_API_KEY and
# GEMINI_API_KEY are forwarded from your shell environment by docker compose, so
# they never land on disk.
SKATEBOARD_TOKEN=change-me-local-dev-token
RUN_STAMP=run1
MAX_ATTEMPTS=3

# 1 (default): stop a model's ladder at its first acceptance -- the demo
# behaviour. 0: run the full MAX_ATTEMPTS budget and record every acceptance
# with its speedup, for a sampling study. After an acceptance the repair context
# resets, so the next attempt starts from pristine source.
STOP_ON_ACCEPT=1

# Model matrix: which registry models to run, in order, and which rung ladder.
# Registry keys: opus, sonnet, haiku, gemini-flash, qwen, codestral
# (see agent-runner/app.py).
MODEL_KEYS=haiku,sonnet,gemini-flash,qwen
RUNGS=stdpar_managed

# Sampling temperature for the OpenAI-compatible backends (Gemini, Ollama).
# 0.2 is the default used by the first campaigns; raise it to widen the spread
# of attempts. Recorded per campaign in experiments/README.md, NOT in the ledger.
AGENT_TEMPERATURE=0.2

# Default backend for a single-model run (when the orchestrator passes no key):
AGENT_MODEL_KEY=sonnet
