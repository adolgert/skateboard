# Copy to .env and adjust. ANTHROPIC_API_KEY is NOT set here — it is forwarded
# from your shell environment by docker compose, so it never lands on disk.
SKATEBOARD_TOKEN=change-me-local-dev-token
AGENT_BACKEND=anthropic
AGENT_MODEL=claude-opus-4-8
RUN_STAMP=run1
MAX_ATTEMPTS=3

# To use a local model via Ollama (OpenAI-compatible), instead set:
#   AGENT_BACKEND=openai
#   AGENT_MODEL=qwen2.5:14b
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
