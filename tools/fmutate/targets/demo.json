{
  "name": "demo-tsunami (mod_kernel + mod_diff, visible corpus)",
  "src_dir": "demo/work/src",
  "mutate": ["mod_kernel.f90", "mod_diff.f90"],
  "build": {
    "fc": "gfortran",
    "sources": [
      "mod_params.f90",
      "mod_diff.f90",
      "mod_initial.f90",
      "mod_kernel.f90"
    ],
    "extra_sources": [
      "demo/capture/mod_capture.f90",
      "demo/capture/replay.f90"
    ],
    "exe": "replay",
    "run_args": ["{case_dir}"],
    "flags": ["-O2", "-ffree-line-length-none"],
    "coverage_flags": ["-O0", "-g", "--coverage", "-ffree-line-length-none"],
    "checked_flags": [
      "-O0",
      "-g",
      "-ffree-line-length-none",
      "-fcheck=all",
      "-finit-real=snan",
      "-ffpe-trap=invalid,zero,overflow"
    ]
  },
  "corpus": {
    "inputs": "demo/orchestrator/datasets/visible",
    "expected": "demo/oracle/captures/visible",
    "case_glob": "case[0-9]*",
    "input_files": ["h_in.bin", "u_in.bin"],
    "variables": {
      "h": "h_out.bin",
      "u": "u_out.bin"
    }
  },
  "comparator": {
    "module": "demo/oracle/compare.py",
    "tolerances": "demo/oracle/tolerances.json"
  }
}
